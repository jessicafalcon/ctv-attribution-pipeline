# Copy to .env (gitignored). Never commit real values; never add to CI.
ANTHROPIC_API_KEY=your-key-here

# Local dev needs neither: all three ClickHouse principals (default, agent_ro,
# metrics_ro) are passwordless in this stack
# (clickhouse/users.d/, host port bound to 127.0.0.1). A hardened deploy points these
# at its own credentials — .env only, never CI.
# CLICKHOUSE_METRICS_USER=metrics_ro      # the Phase-18a storage scrape
# CLICKHOUSE_METRICS_PASSWORD=
