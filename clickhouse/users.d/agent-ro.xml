<clickhouse>
  <!--
    The agent's SELECT-only principal (Phase-9 Ruling D). Identity lives in users.d,
    like allow-network.xml, and is reconstructed from this file at every container
    start — it cannot drift the way a SQL-created user in the mutable access/ store
    can. `agent_ro` is granted ONLY `SELECT ON default.*`, so a write (INSERT / ALTER
    / DROP / CREATE) is refused at the database with ACCESS_DENIED, not by convention:
    it backs the whole agent read path (collectors + probes) and the write-denied
    test.

    Grant form, NOT <readonly>1</readonly>: readonly=1 can reject the benign session
    settings clickhouse-connect sends on connect (400), whereas a SELECT grant is
    enforced at the access-control layer and leaves the session alone. Inline <grants>
    is supported since ClickHouse 22.4 (image is 24.8).

    Passwordless, ::/0, same local-dev posture as allow-network.xml: the host publishes
    8123 on 127.0.0.1 only (compose), so the service stays off the LAN. Not for
    shared/multi-user hosts (BACKLOG). No secret is committed.
  -->
  <users>
    <agent_ro>
      <password></password>
      <networks replace="replace">
        <ip>::/0</ip>
      </networks>
      <grants>
        <query>GRANT SELECT ON default.*</query>
      </grants>
    </agent_ro>
  </users>
</clickhouse>
